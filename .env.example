# Multi-provider LLM Configuration (OpenRouter / Groq / Cohere / Gemini / Anthropic)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-r-plus

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

EQ_BACKEND=auto
EQ_MODEL_PATH=models/eq_model.pkl

# Relational Structured State (PostgreSQL / SQLite)
DATABASE_URL=postgresql+psycopg2://persona:persona_secure_password@localhost:5432/persona
PERSONA_DB_PATH=data/persona.db

# Message Broker & Task Queue (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Cache & Celery Result Backend (Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Document & Interaction Trace Storage (MongoDB)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=persona_ai

# Context & Evaluator Settings
MAX_RECENT_TURNS=12
MAX_MEMORIES_RETRIEVED=6
MAX_REGENERATION_ATTEMPTS=2
MIN_ACCEPTABLE_SCORE=0.55

# LLM Reliability Settings
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_BASE=1.5

# Embedding Backend ("tfidf" default, or "sentence_transformers" with extra deps)
EMBEDDING_BACKEND=tfidf

# API Authentication (optional - set to enable Bearer token auth)
# PERSONA_API_KEY=your_secret_api_key_here
